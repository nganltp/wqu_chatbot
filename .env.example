QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wqu_help
# Optional Docker-free mode. When set, it takes precedence over QDRANT_URL.
# QDRANT_LOCAL_PATH=data/qdrant
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# Optional: needed only when the embedding model requires authenticated Hugging Face access.
HF_TOKEN=hf_replace_with_your_token

# Create an OpenAI API key and never commit the real value.
OPENAI_API_KEY=sk-replace_with_your_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

# Comma-separated browser origins allowed to call the API.
# Add the exact Cloudflare Pages URL after the first deployment.
CORS_ORIGINS=http://localhost:8000,http://localhost:5500,http://127.0.0.1:5500
TOP_K=5
MIN_RETRIEVAL_SCORE=0.35
HYBRID_DENSE_CANDIDATES=10
HYBRID_KEYWORD_CANDIDATES=10
HYBRID_MIN_KEYWORD_SCORE=1.0
HYBRID_RRF_RANK_CONSTANT=60

# Daily per-IP quota (persistent across restarts).
DAILY_QUESTION_LIMIT=10
RATE_LIMIT_DB_PATH=data/chat_usage.sqlite3
RATE_LIMIT_TIMEZONE=Asia/Singapore
# Enable only for local cloudflared; bind API to loopback with --no-proxy-headers.
TRUST_CLOUDFLARE_TUNNEL=false
